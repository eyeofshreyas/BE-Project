SUPABASE_URL=
SUPABASE_KEY=

FRONTEND_URL=http://localhost:5173

# Optional -- client-request invite emails are skipped (logged only) if unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional -- the client Invoices page's "Pay Now" button returns a 500 (Razorpay not
# configured) until these are set. Use test-mode keys from the Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional -- a case's "Sync with eCourts" button returns a 500 (eCourts sync not
# configured) until this is set. Get a key (free trial credits) at https://ecourtsindia.com/api.
ECOURTS_API_KEY=

# Optional -- a document's "Request e-signature" button returns a 500 (e-signature not
# configured) until these are set. Sign up at https://www.leegality.com, enable API access
# under Settings > API to get the auth token and private salt, and create a Workflow in the
# dashboard first (Document Execution > Workflows) to get the profile ID.
LEEGALITY_AUTH_TOKEN=
LEEGALITY_PRIVATE_SALT=
LEEGALITY_WORKFLOW_PROFILE_ID=
