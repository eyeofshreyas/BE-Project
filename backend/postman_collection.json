{
  "info": {
    "name": "LexFlow Backend",
    "description": "Endpoints built so far on feature/backend-ml. Run the backend locally first: cd backend && source .venv/bin/activate && uvicorn main:app --reload",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/", "host": ["{{base_url}}"], "path": [""] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup - Lawyer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/signup", "host": ["{{base_url}}"], "path": ["signup"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.lawyer@example.com\",\n  \"password\": \"TestPass123!\",\n  \"full_name\": \"Adv. Test Lawyer\",\n  \"phone\": \"9000000000\",\n  \"role\": \"lawyer\",\n  \"bar_council_number\": \"BC-1234\",\n  \"specialization\": \"Corporate Law\",\n  \"experience_years\": 5\n}"
            }
          }
        },
        {
          "name": "Signup - Client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/signup", "host": ["{{base_url}}"], "path": ["signup"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.client@example.com\",\n  \"password\": \"TestPass123!\",\n  \"full_name\": \"Test Client\",\n  \"phone\": \"9111111111\",\n  \"role\": \"client\",\n  \"address\": \"123 Test Street\",\n  \"preferred_language\": \"Hindi\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rajesh@lexflow.com\",\n  \"password\": \"<real-password>\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/forgot-password", "host": ["{{base_url}}"], "path": ["forgot-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rajesh@lexflow.com\"\n}"
            }
          }
        },
        {
          "name": "Protected (needs Bearer token from Login)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/protected", "host": ["{{base_url}}"], "path": ["protected"] }
          }
        }
      ]
    },
    {
      "name": "Cases",
      "item": [
        {
          "name": "List Cases",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/cases", "host": ["{{base_url}}"], "path": ["cases"] }
          }
        }
      ]
    },
    {
      "name": "Conveyancing",
      "item": [
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/conveyancing/summary", "host": ["{{base_url}}"], "path": ["conveyancing", "summary"] }
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/documents", "host": ["{{base_url}}"], "path": ["documents"] }
          }
        },
        {
          "name": "Get Document Summary",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/documents/1/summary", "host": ["{{base_url}}"], "path": ["documents", "1", "summary"] }
          }
        }
      ]
    },
    {
      "name": "Billing",
      "item": [
        {
          "name": "List Invoices",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/billing/invoices", "host": ["{{base_url}}"], "path": ["billing", "invoices"] }
          }
        },
        {
          "name": "Get Invoice",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/billing/invoices/1", "host": ["{{base_url}}"], "path": ["billing", "invoices", "1"] }
          }
        },
        {
          "name": "Create Invoice",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/billing/invoices", "host": ["{{base_url}}"], "path": ["billing", "invoices"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_id\": 1,\n  \"invoice_number\": \"INV-1010\",\n  \"amount\": 5000,\n  \"tax\": 900,\n  \"total_amount\": 5900,\n  \"issue_date\": \"2026-08-27\",\n  \"due_date\": \"2026-09-27\"\n}"
            }
          }
        },
        {
          "name": "List Payments for Invoice",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/billing/invoices/1/payments", "host": ["{{base_url}}"], "path": ["billing", "invoices", "1", "payments"] }
          }
        },
        {
          "name": "Record Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/billing/payments", "host": ["{{base_url}}"], "path": ["billing", "payments"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoice_id\": 1,\n  \"amount\": 5900,\n  \"payment_method\": \"UPI\",\n  \"transaction_reference\": \"TXN123456\",\n  \"payment_date\": \"2026-08-27\"\n}"
            }
          }
        },
        {
          "name": "List Expenses",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/billing/expenses", "host": ["{{base_url}}"], "path": ["billing", "expenses"] }
          }
        },
        {
          "name": "List Expenses for Matter",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/billing/expenses?matter_id=10",
              "host": ["{{base_url}}"],
              "path": ["billing", "expenses"],
              "query": [{ "key": "matter_id", "value": "10" }]
            }
          }
        },
        {
          "name": "Create Expense",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/billing/expenses", "host": ["{{base_url}}"], "path": ["billing", "expenses"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matter_id\": 10,\n  \"expense_type\": \"Stamp Duty\",\n  \"description\": \"Registration stamp duty\",\n  \"amount\": 15000,\n  \"expense_date\": \"2026-08-27\",\n  \"created_by\": 1\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Meetings",
      "item": [
        {
          "name": "List Meetings",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/meetings", "host": ["{{base_url}}"], "path": ["meetings"] }
          }
        },
        {
          "name": "List Meetings for Case",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/meetings?case_id=1",
              "host": ["{{base_url}}"],
              "path": ["meetings"],
              "query": [{ "key": "case_id", "value": "1" }]
            }
          }
        },
        {
          "name": "Get Meeting",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/meetings/1", "host": ["{{base_url}}"], "path": ["meetings", "1"] }
          }
        },
        {
          "name": "Create Meeting",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/meetings", "host": ["{{base_url}}"], "path": ["meetings"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_id\": 1,\n  \"conducted_by\": 1,\n  \"meeting_title\": \"Initial client consultation\",\n  \"meeting_type\": \"Consultation\",\n  \"meeting_date\": \"2026-09-01T10:00:00\",\n  \"duration_minutes\": 45,\n  \"agenda\": \"Discuss case strategy\"\n}"
            }
          }
        },
        {
          "name": "List Participants",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/meetings/1/participants", "host": ["{{base_url}}"], "path": ["meetings", "1", "participants"] }
          }
        },
        {
          "name": "Add Participant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/meetings/1/participants", "host": ["{{base_url}}"], "path": ["meetings", "1", "participants"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 2,\n  \"participant_role\": \"Client\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Hearings",
      "item": [
        {
          "name": "List Hearings",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/hearings", "host": ["{{base_url}}"], "path": ["hearings"] }
          }
        },
        {
          "name": "List Hearings for Case",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/hearings?case_id=1",
              "host": ["{{base_url}}"],
              "path": ["hearings"],
              "query": [{ "key": "case_id", "value": "1" }]
            }
          }
        },
        {
          "name": "Get Hearing",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/hearings/1", "host": ["{{base_url}}"], "path": ["hearings", "1"] }
          }
        },
        {
          "name": "Create Hearing",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/hearings", "host": ["{{base_url}}"], "path": ["hearings"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_id\": 1,\n  \"judge_id\": 1,\n  \"hearing_date\": \"2026-09-15\",\n  \"hearing_time\": \"10:00:00\",\n  \"courtroom\": \"Court Room 1\",\n  \"notes\": \"Next hearing\"\n}"
            }
          }
        },
        {
          "name": "Update Hearing (mark completed)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/hearings/1", "host": ["{{base_url}}"], "path": ["hearings", "1"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hearing_status\": \"Completed\",\n  \"hearing_outcome\": \"Adjourned to next date\",\n  \"next_hearing_date\": \"2026-10-01\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "AI",
      "item": [
        {
          "name": "Similar Case Search",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/ai/similar-cases", "host": ["{{base_url}}"], "path": ["ai", "similar-cases"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"The appellant was convicted under section 302 of the Indian Penal Code for murder\",\n  \"top_k\": 5\n}"
            }
          }
        },
        {
          "name": "Summarize Judgment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/ai/summarize", "host": ["{{base_url}}"], "path": ["ai", "summarize"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Paste a judgment excerpt here...\",\n  \"document_id\": null\n}"
            }
          }
        }
      ]
    }
  ]
}
