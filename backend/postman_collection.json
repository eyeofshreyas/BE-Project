{
  "info": {
    "name": "LexFlow Backend",
    "description": "Endpoints built so far on feature/backend-ml. Run the backend locally first: cd backend && source .venv/bin/activate && uvicorn main:app --reload. Every endpoint except Root/Signup/Login/Forgot Password now requires auth: run Login once (any real account) and its test script auto-fills the access_token collection variable used by every other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                ""
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup - Lawyer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.lawyer@example.com\",\n  \"password\": \"TestPass123!\",\n  \"full_name\": \"Adv. Test Lawyer\",\n  \"phone\": \"9000000000\",\n  \"role\": \"lawyer\",\n  \"bar_council_number\": \"BC-1234\",\n  \"specialization\": \"Corporate Law\",\n  \"experience_years\": 5\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Signup - Client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.client@example.com\",\n  \"password\": \"TestPass123!\",\n  \"full_name\": \"Test Client\",\n  \"phone\": \"9111111111\",\n  \"role\": \"client\",\n  \"address\": \"123 Test Street\",\n  \"preferred_language\": \"Hindi\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rajesh@lexflow.com\",\n  \"password\": \"<real-password>\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.access_token) { pm.collectionVariables.set('access_token', data.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/forgot-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "forgot-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rajesh@lexflow.com\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Protected (needs Bearer token from Login)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/protected",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "protected"
              ]
            }
          }
        }
      ]
    },
